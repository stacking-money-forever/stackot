{
  "id": "stackot-gateway",
  "name": "Stackot Gateway guards",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object", "additionalProperties": false,
    "properties": {
      "agentId": { "type": "string", "minLength": 1 },
      "qa": {
        "type": "object", "additionalProperties": false, "required": ["enabled"],
        "properties": {
          "enabled": { "type": "boolean" },
          "fixtureId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "accountId": { "type": "string", "minLength": 1 },
          "guildId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
          "threadId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
          "forumId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
          "requesterId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
          "secondUserId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
        }
      }
    },
    "required": ["agentId"]
  }
}
