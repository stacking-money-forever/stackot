# Values the runtime VM needs that are NOT in the repository.
#
# Copy to /etc/stackot/receiver.env (0600, root:stackot) for the receiver unit,
# and set the two Caddy variables in /etc/default/caddy. Never commit a filled
# copy of this file — the receiver's own redaction only protects logs.

# --- receiver unit ---------------------------------------------------------
STACKOT_CONFIG=/etc/stackot/receiver.json
STACKOT_OUTBOX_PATH=/var/lib/stackot/outbox.sqlite

# --- Caddy (public ingress) ------------------------------------------------
# The hostname GitHub posts to. A DNS A/AAAA record must already point here.
STACKOT_DOMAIN=<stackot.example.com>
ACME_EMAIL=<you@example.com>

# --- values that go inside /etc/stackot/receiver.json ----------------------
# Copy receiver/config.example.json and fill these; the receiver refuses to
# start when any required value is missing, blank or a <...> placeholder.
#
#   githubWebhookSecret    GitHub webhook secret (shared by every repo)
#   openclawHooksUrl       http://127.0.0.1:18789/hooks  (gateway stays loopback)
#   openclawHookToken      the gateway's hooks.token
#   githubToken            shared GitHub token (repo:read minimum)
#   discordGuildId         the guild that backlinks are trusted from
#   githubBacklinkLogin    the account that records thread URLs in GitHub
#   repos["owner/name"]    issuesForumChannelId + prsForumChannelId
#                          (+ githubToken when that repo gets its own credential)
#   ciAlertsChannelId      #ci-alerts
#   adminChannelId         #stackot-admin
#   agentId                the OpenClaw agent that owns the stackot skill

# --- gateway / worker ------------------------------------------------------
# Discord bot token for the OpenClaw gateway: ~/.openclaw/.env as DISCORD_BOT_TOKEN
# Coding harness auth (the ACP worker runs codex): complete the login on this VM
# before enabling workers — `codex` must already be authenticated.
