# Stackot 환경 변수 — 복사해서 .env로 쓰고 값을 채운다.
# 절대 커밋 금지. 유출 시 즉시 재발급.
#
# 생성: cp .env.example .env
# 랜덤 토큰 생성: openssl rand -hex 32

# ── Discord ──────────────────────────────────────────────────────
# Developer Portal → 앱 → Bot → Reset Token (bot-setup.md §1)
DISCORD_BOT_TOKEN=

# ── OpenClaw Gateway ─────────────────────────────────────────────
# Receiver → Gateway /hooks/agent 인증용 (deploy/README.md §2와 openclaw.json5
# 의 hooks.token과 동일한 값)
STACKOT_HOOK_TOKEN=

# ── GitHub ───────────────────────────────────────────────────────
# GitHub webhook secret — GitHub 저장소 Settings → Webhooks에 입력한 값과
# 동일해야 함 (receiver config.json의 githubWebhookSecret)
STACKOT_GITHUB_WEBHOOK_SECRET=

# repo:read 최소권한 PAT — Receiver의 매핑 역링크 조회용
# (https://github.com/settings/tokens → Fine-grained: Contents read)
STACKOT_GITHUB_TOKEN=

# ── Receiver 실행 ────────────────────────────────────────────────
# config.json 경로 (미설정 시 receiver/config.json 기본)
STACKOT_CONFIG=
